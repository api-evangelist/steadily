        {
          "id": "c4fa3354-e3ce-4ce7-afa2-493179b415b5",
          "name": "Agent Bearer Token",
          "request": {
            "name": "Agent Bearer Token",
            "description": {
              "content": "Generate a Bearer token on behalf of a licensed insurance agent.\n\nYou can pass any agent email in the `agent.email` field of the token request to associate quotes with sub-agents in your organization.\nThe quote will be attributed to that agent as the producing agent and accessible to other agents under the same agency.\nHowever, the agent must be appointed with Steadily in order for them to log in to our UI when bridging over.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "account",
                "agency",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-Steadily-ApiKey"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "query"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"agent\": {\n    \"first_name\": \"<string>\",\n    \"last_name\": \"<string>\",\n    \"licensed_states\": [\n      {\n        \"state\": \"<string>\",\n        \"state_producer_number\": \"<string>\"\n      },\n      {\n        \"state\": \"<string>\",\n        \"state_producer_number\": \"<string>\"\n      }\n    ],\n    \"email\": \"<email>\",\n    \"national_producer_number\": \"<string>\",\n    \"profile_id\": \"<string>\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
